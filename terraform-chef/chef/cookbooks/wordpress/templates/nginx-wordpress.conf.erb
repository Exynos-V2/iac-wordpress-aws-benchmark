server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    root <%= @wp_root %>;
    index index.php index.html;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:<%= @php_socket %>;
    }

    location ~ /\.ht {
        deny all;
    }
}
